# Backend API Host URL
VITE_API_URL=http://localhost:8000

# Optional: full base URL with API prefix (defaults to ${VITE_API_URL}/api/v1)
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# JWT authentication is configured and signed by the backend.
# Never expose SECRET_KEY or ADMIN_PASSWORD in frontend environment variables.
# The frontend stores the issued access token under the admin_token key.
